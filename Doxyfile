# Project information
PROJECT_NAME           = "CSV Query Engine"
PROJECT_NUMBER         = "1.0"

# Input configuration
INPUT                  = backend backend-entry-point backend-query-header README.md
FILE_PATTERNS          = *.h *.cpp *.hpp .md
RECURSIVE              = YES

USE_MDFILE_AS_MAINPAGE = README.md

# Extraction configuration
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

EXCLUDE                = build \
                         out \
                         bin \
                         node_modules \
                         .git \
                         .vscode \
                         backend-tests \
                         backend/packages \
                         packages

EXCLUDE_SYMBOLS          = std \
                           std::* \
                           testing \
                           testing::* \
                           testing_internal \
                           testing_internal::* \
                           proto2 \
                           proto2::* 

# Output configuration
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Diagrams
HAVE_DOT               = NO